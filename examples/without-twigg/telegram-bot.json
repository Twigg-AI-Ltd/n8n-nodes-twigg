{
  "name": "Telegram bot (classic: OpenAI + Postgres memory)",
  "nodes": [
    {
      "id": "e2114159-f04d-535c-9f54-644b375ee70a",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        100
      ],
      "parameters": {
        "updates": [
          "message"
        ],
        "additionalFields": {}
      },
      "webhookId": "1981bc31-d3f2-5968-964c-0295a2f8a39d"
    },
    {
      "id": "c024ea74-054f-56f4-9202-4d66c079ee1c",
      "name": "Is /reset?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        220,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": false,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "41e6ea41-cbca-5af5-beef-409a84a80053",
              "leftValue": "={{ $json.message.text }}",
              "rightValue": "/reset",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "3712af9f-279f-5d7b-af43-7c099b777115",
      "name": "Assistant",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        480,
        200
      ],
      "parameters": {
        "promptType": "define",
        "text": "={{ $json.message.text }}",
        "options": {
          "systemMessage": "You are a helpful personal assistant on Telegram. Keep replies short. Remember what the user tells you about themselves and use it."
        }
      }
    },
    {
      "id": "e2c547a3-a0d6-58e8-be7f-cece679b7abc",
      "name": "Send reply",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        820,
        200
      ],
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.output }}",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "d166fa30-0040-5071-aaa8-6f7cccddaed7",
      "name": "Confirm reset",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        820,
        -60
      ],
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "Done, I've forgotten our conversation. What can I do for you?",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
    {
      "id": "a3d1855b-7b91-5225-933c-7f2321804b26",
      "name": "Forget conversation",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        -60
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "DELETE FROM n8n_chat_histories WHERE session_id = $1",
        "options": {
          "queryReplacement": "={{ String($json.message.chat.id) }}"
        }
      }
    },
    {
      "id": "f2cc01da-3ef6-5be6-a194-e762935e2b73",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1.3,
      "position": [
        400,
        420
      ],
      "parameters": {
        "model": {
          "__rl": true,
          "mode": "list",
          "value": "gpt-5-mini"
        },
        "options": {}
      }
    },
    {
      "id": "51c74bae-37cf-5ea3-a4df-d178236d9591",
      "name": "Postgres Chat Memory",
      "type": "@n8n/n8n-nodes-langchain.memoryPostgresChat",
      "typeVersion": 1.4,
      "position": [
        560,
        420
      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "contextWindowLength": 10
      }
    },
    {
      "id": "0138b0f4-4d9c-5239-adbb-ff4b768be556",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -40
      ],
      "parameters": {
        "content": "## Telegram bot, classic setup (for comparison)\nOpenAI + **Postgres Chat Memory**, plus a raw SQL `DELETE` for `/reset`.\n\nYou need a Postgres database and credential, and the reset query has to match the table and session id format the memory node uses.\n\nSee `../twigg/telegram-bot.json` for the same bot on Twigg.",
        "width": 380,
        "height": 320,
        "color": 3
      }
    }
  ],
  "connections": {
    "Telegram Trigger": {
      "main": [
        [
          {
            "node": "Is /reset?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is /reset?": {
      "main": [
        [
          {
            "node": "Forget conversation",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Assistant",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Assistant": {
      "main": [
        [
          {
            "node": "Send reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Forget conversation": {
      "main": [
        [
          {
            "node": "Confirm reset",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "Assistant",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    },
    "Postgres Chat Memory": {
      "ai_memory": [
        [
          {
            "node": "Assistant",
            "type": "ai_memory",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
