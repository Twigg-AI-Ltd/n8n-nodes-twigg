      ],
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Incoming WhatsApp message').item.json.body.from }}",
        "contextWindowLength": 10
      }
    },
    {
      "id": "0138b0f4-4d9c-5239-adbb-ff4b768be556",
      "name": "Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -40
      ],
      "parameters": {
        "content": "## Lead qualifier, classic setup (for comparison)\nOpenAI Chat Model + **Postgres Chat Memory** keyed by phone number.\n\nNeeds a Postgres (or Supabase) database and credential; n8n creates the `n8n_chat_histories` table. Phone numbers are stored in plain text. The window keeps the last 10 messages, so details given early in a long chat drop out.\n\nSee `../twigg/lead-qualifier.json` for the same flow on Twigg.",
        "width": 380,
        "height": 380,
        "color": 3
      }
    }
  ],
